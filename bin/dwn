#!/usr/bin/env zsh
#
# Simple download manager.
#
#
# Author: Brandon Lepore <https://github.com/fatherbrennan>
# Date: June 05, 2025
# License: MIT

PROG_NAME=dwn
PROG_VERSION=  # format: 0.0.0
PROG_CMD=dwn   # dwn | continue | list | remove
SYS_OS=macos   # macos | linux | windows
DIR_LIST="$DWN_INSTALL/bin/list"

# Error codes.
E_CMD_INVALID=001
E_CMD_OPT_INVALID=002
E_CMD_OPT_VAL_REQUIRED=003
E_SYS_OS_UNSUPPORTED=010
E_SYS_OS_UNKNOWN=011
E_DWN_OUTPUT_FILE_EXISTS=020
E_DWN_REMOTE_PING_FAILED=021
E_ITEM_CREATE_FAILED=022
E_ITEM_REMOVE_FAILED=023
E_ITEM_REMOVE_LOCAL_FAILED=024
E_REMOVE_UNKNOWN_ID=030

typeset -A ERROR=()
ERROR[$E_CMD_INVALID]='this just is not a command'
ERROR[$E_SYS_OS_UNSUPPORTED]="$SYS_OS is not supported"
ERROR[$E_SYS_OS_UNKNOWN]="'$SYS_OS' cannot be a real operating system"
ERROR[$E_DWN_REMOTE_PING_FAILED]='remote content does not contain Content-Length'

# return expected result of bool function.
# 0 = false
# 1 = true
# $1 `0` or `1`
bool() {
  [[ $1 -eq 1 ]] && return 0 || return 1
}

log_error_exit() {
  printf '[ERROR:%s]:\t%b\n' "$1" "$ERROR[$1]" && exit 1
}

log() {
  printf '%b\n' "$1"
}

print_version_exit() {
  cat "$DWN_INSTALL/bin/version" && exit 0
}

# $1 value of `$PROG_CMD`.
print_help_exit() {
  cat "$DWN_INSTALL/bin/help/$1" && exit 0
}

print_usage_exit() {
  cat "$DWN_INSTALL/bin/usage" && exit 0
}

# set the operating system.
# error if not supported.
set_os() {
  case "$OSTYPE" in
    'darwin'*) SYS_OS=macos ;;
    'linux'*) SYS_OS=linux ;;
    'cygwin' | 'msys' | 'win32')
      SYS_OS=windows
      log_error_exit $E_SYS_OS_UNSUPPORTED
      ;;
    *) log_error_exit $E_SYS_OS_UNKNOWN ;;
  esac
}

# `PROG_CMD` whitelist.
allow_cmd() {
  for cmd in "$@"; do
    [[ "$PROG_CMD" == "$cmd" ]] && return 0
  done
  return 1
}

# throw error if argument after option is empty.
# $1 opt.
# $2 expected opt value.
enforce_opt() {
  ERROR[$E_CMD_OPT_VAL_REQUIRED]="option is empty with no value: $1"
  [[ -z "$2" ]] && log_error_exit $E_CMD_OPT_VAL_REQUIRED
}

# return a random id.
generate_id() {
  openssl rand -hex 4
}

# return 0 when file exists.
# $1 file path.
file_exists() {
  [[ -e "$1" ]] && return 0 || return 1
}

# create list item.
#
# item filename is `id`, with following lines as content:
#  - output file path
#  - url
#  - content size in bytes
#
# $1 id.
# $2 absolute path of output file.
# $3 remote url.
# $4 content size in bytes.
create_list_item() {
  ERROR[$E_ITEM_CREATE_FAILED]="failed to create item: $1"
  printf '%s\n%s\n%s' "$2" "$3" "$4" >"$DIR_LIST/$1" &&
    log "[$1]: created" ||
      log_error_exit $E_ITEM_CREATE_FAILED
}

# remove list item.
# $1 id.
remove_list_item() {
  ERROR[$E_ITEM_REMOVE_FAILED]="failed to remove item: $1"
  rm "$DIR_LIST/$id" 2>&1 &&
    log "[$id]: removed" ||
      log_error_exit $E_ITEM_REMOVE_FAILED
}

# return `id` list item output file.
# $1 id.
get_list_item_output_file() {
  head -n 1 "$DIR_LIST/$1"
}

# return `id` list item url.
# $1 id.
get_list_item_url() {
  head -n 2 "$DIR_LIST/$1" | tail -n 1
}

# return `id` list item content size.
# $1 id.
get_list_item_size() {
  head -n 3 "$DIR_LIST/$1" | tail -n 1
}

get_list_items_count() {
  printf '%d' "$(ls "$DIR_LIST" | wc -l | tr -d ' ')"
}

# download list item.
# $1 id.
download_list_item() {
  log "[$1]: download\n"
  wget -c -nv --show-progress -O \
    "$(get_list_item_output_file "$1")" "$(get_list_item_url "$1")"
}

# download item.
# $1 remote url.
run_download() {
  local remote_url="$1"
  local output_file="$opt_o"
  ERROR[$E_DWN_OUTPUT_FILE_EXISTS]="file exists: $output_file"
  ERROR[$E_DWN_OUTPUT_FILE_INVALID]="file is invalid: $output_file"

  if bool $has_opt_o; then
    # check if the output file exists.
    [[ -f "$output_file" ]] && log_error_exit $E_DWN_OUTPUT_FILE_EXISTS
    # check if the output file can be created.
    [[ ! -e "$output_file" && -w "${output_file:h}" ]] ||
       log_error_exit $E_DWN_OUTPUT_FILE_INVALID
  else
    # use the basename of the url as the output file.
    output_file="${remote_url:t}"
  fi

  # get the absolute output file path.
  output_file=${output_file:P}
  local id=$(generate_id)

  # ensure unique id.
  while file_exists "$DIR_LIST/$id"; do
    id=$(generate_id)
  done

  local content_length=$(wget --spider -S -t=1 "$remote_url" 2>&1 |
    sed -n 's/[[:space:]]*Content-Length:[[:space:]]*//p')

    # throws if invalid remote url, or no content length.
  [[ -z "$content_length" ]] && log_error_exit $E_DWN_REMOTE_PING_FAILED

  # add item to list if ignore option is absent.
  bool "$has_opt_i" ||
    create_list_item "$id" "$output_file" "$remote_url" "$content_length"

  download_list_item "$id"
}

# list items.
run_list() {
  if [[ $(get_list_items_count) -eq 0 ]]; then
    log '0 items' && exit 0
  fi

  local count=$((0))
  local table='ID|%%|Progress|Output|URL\n`|`|`|`\n'

  for item in "$DIR_LIST"/*; do
    if file_exists "$item"; then
      local id="${item:t}"
      local output_file=$(get_list_item_output_file "$id")
      local size=$(get_list_item_size "$id")
      local file_size=$(file_exists "$output_file" &&
        cat "$output_file" | wc -c | tr -d ' ' || printf 0)
      local percent=$(printf %.f $(($file_size * 100 / $size)))

      bool $has_opt_c && [[ "$percent" -ne 100 ]] && continue
      bool $has_opt_i && [[ "$percent" -eq 100 ]] && continue

      ((count++))
      table+="$id|$percent|[$file_size/$size]|$output_file|$(get_list_item_url "$id")\n"
    fi
  done

  log "$count items\n"
  printf "$table" | column -t -s '|'
}

# remove list items.
# $@ space separated ids.
run_remove() {
  local ids="$@"

  # add all item ids.
  if bool $has_opt_a || bool $has_opt_c || bool $has_opt_i; then
    if [[ $(get_list_items_count) -gt 0 ]]; then
      ids=()
      local items=("$DIR_LIST"/*)
      for item in "${items[@]}"; do
        local id="${item:t}"
        local output_file=$(get_list_item_output_file "$id")
        local size=$(get_list_item_size "$id")
        local file_size=$(file_exists "$output_file" &&
          cat "$output_file" | wc -c | tr -d ' ' || printf 0)
        local percent=$(printf %.f $(($file_size * 100 / $size)))

        if ! bool $has_opt_a; then
          bool $has_opt_c && [[ "$percent" -ne 100 ]] && continue
          bool $has_opt_i && [[ "$percent" -eq 100 ]] && continue
        fi

        ids+=("$id")
      done
    fi
  fi

  for id in "${ids[@]}"; do
    ! file_exists "$DIR_LIST/$id" && log "[$id]: missing" && continue

    # remove the local corresponding file.
    if bool $has_opt_f; then
      local output_file="$(get_list_item_output_file $id)"
      ERROR[$E_ITEM_REMOVE_LOCAL_FAILED]="[$id][$output_file]: failed to remove"
      rm "$output_file" 2>&1 &&
        log "[$id][$output_file]: removed" ||
          log_error_exit $E_ITEM_REMOVE_LOCAL_FAILED
    fi

    remove_list_item "$id"
  done
}

# continue a previous download.
# $@ space separated ids.
run_continue() {
  for id in "$@"; do
    ! file_exists "$DIR_LIST/$id" && log "[$id]: missing" && continue
    download_list_item "$id"
  done
}

main() {
  # print usage and exit if no arguments specified.
  if [[ "$#" -eq 0 ]]; then
    print_usage_exit
  fi

  # ensure list directory exists.
  if [[ ! -d "$DIR_LIST" ]]; then
    mkdir "$DIR_LIST"
  fi

  set_os

  local has_opt_a=0
  local has_opt_c=0
  local has_opt_f=0
  local has_opt_h=0
  local has_opt_i=0
  local has_opt_r=0
  local has_opt_o=0
  local has_opt_v=0
  local opt_o=''

  while [[ $# -gt 0 ]]; do
    ERROR[$E_CMD_OPT_INVALID]="option '$1' with '$PROG_CMD'... no."
    case "$1" in
      version | -v | '--version') print_version_exit ;;
      help | -h | '--help') print_help_exit "$PROG_CMD" ;;
      usage) print_usage_exit ;;
      continue)
        PROG_CMD=continue
        shift
        ;;
      ls | list)
        PROG_CMD=list
        shift
        ;;
      rm | remove)
        PROG_CMD=remove
        shift
        ;;
      -a)
        allow_cmd remove || log_error_exit $E_CMD_OPT_INVALID
        has_opt_a=1
        shift
        ;;
      -c)
        allow_cmd list remove || log_error_exit $E_CMD_OPT_INVALID
        has_opt_c=1
        shift
        ;;
      -f)
        allow_cmd remove || log_error_exit $E_CMD_OPT_INVALID
        has_opt_f=1
        shift
        ;;
      -i)
        allow_cmd list remove || log_error_exit $E_CMD_OPT_INVALID
        has_opt_i=1
        shift
        ;;
      -o)
        allow_cmd dwn || log_error_exit $E_CMD_OPT_INVALID
        has_opt_o=1
        enforce_opt "$1" "$2"
        opt_o="$2"
        shift 2
        ;;
      -r)
        allow_cmd dwn || log_error_exit $E_CMD_OPT_INVALID
        has_opt_i=1
        shift
        ;;
      *)
        allow_cmd dwn continue remove || log_error_exit $E_CMD_INVALID
        break
        ;;
    esac
  done

  case "$PROG_CMD" in
    dwn) run_download "$@" ;;
    continue) run_continue "$@" ;;
    list) run_list ;;
    remove) run_remove "$@" ;;
  esac

  return 0
}

main "$@"
