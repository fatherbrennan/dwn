#!/bin/zsh

SYSTEM_OS=macos                                     # macos | linux | windows
DWN_VERSION=$(head -n 1 "$DWN_INSTALL/bin/version") # format: 0.0.0
DWN_CMD=dwn                                         # dwn | continue | list | remove

DIR_TEMP="$(mktemp -d)"
DIR_LIST="$DWN_INSTALL/bin/list"

FILE_ZSHRC="$HOME/.zshrc"

do_remove_after_first_try=0
do_show_complete_list=0
do_show_incomplete_list=0
dwn_url=
dwn_output_file=
has_output_file=0

# error codes.
ERROR_SYSTEM_OS_UNKNOWN=001
ERROR_SYSTEM_OS_UNSUPPORTED=002
ERROR_OPTION_INVALID_CMD=010
ERROR_RUN_COMMAND_UNKNOWN=020
ERROR_DWN_OUTPUT_FILE_EXISTS=030
ERROR_DWN_OUTPUT_FILE_INVALID=031
ERROR_DWN_PING_FAILED=032

# error code messages.
typeset -A ERROR=()
ERROR[$ERROR_SYSTEM_OS_UNKNOWN]="unknown operating system: $OSTYPE"
ERROR[$ERROR_SYSTEM_OS_UNSUPPORTED]="unsupported operating system: $OSTYPE"
ERROR[$ERROR_OPTION_INVALID_CMD]="$DWN_CMD command does not support passed option, for more information use\n\n    dwn usage\n"
ERROR[$ERROR_RUN_COMMAND_UNKNOWN]="i have no idea how you got here, but i'm not going to let you do that"
ERROR[$ERROR_DWN_OUTPUT_FILE_EXISTS]="output file already exists"
ERROR[$ERROR_DWN_OUTPUT_FILE_INVALID]="you can't put that there"
ERROR[$ERROR_DWN_PING_FAILED]="you just might be schizophrenic"

# print line.
function print_ln() {
  printf '%s\n' "$1"
}

# print error code and message, and exit with non-zero code.
# $1 ERROR code.
function log_error_exit() {
  printf '[ERROR:%s]:\t%b\n' "$1" "$ERROR[$1]" && exit 1
}

# print warning log message.
# $1 warning message.
function log_warn() {
  printf '[WARN]:\t%b\n' "$1"
}

# print log message.
# $1 log message.
function log() {
  printf '%b\n' "$1"
}

# return expected result of bool function.
# ```zsh
# is_true=1
# is_false=0
# bool $is_true && print_ln true || print_ln false # true
# bool $is_false && print_ln true || print_ln false # false
# ```
# $1 `0` (`false`) or `1` (`true`).
function bool() {
  if [[ $1 -eq 1 ]]; then
    return 0
  else
    return 1
  fi
}

# set the operating system.
# error if not supported.
function set_os() {
  if [[ "$OSTYPE" == "darwin"* ]]; then
    SYSTEM_OS=macos
  elif [[ "$OSTYPE" == "linux"* ]]; then
    SYSTEM_OS=linux
  elif [[ "$OSTYPE" == "cygwin" || "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
    SYSTEM_OS=windows
    log_error_exit $ERROR_SYSTEM_OS_UNSUPPORTED
  else
    log_error_exit $ERROR_SYSTEM_OS_UNKNOWN
  fi
  log "$SYSTEM_OS"
}

# return 0 if file exists, 1 if not.
# $1 file path.
function file_exists() {
  if [[ -f "$1" ]]; then
    return 0
  else
    return 1
  fi
}

# todo: this needs to be updated, simple placeholder for now.
# print usage and exit gracefully.
function print_usage_exit() {
  print_ln 'usage: dwn [options] [arguments]' && exit 0
}

# print the version and exit gracefully.
function print_version_exit() {
  print_ln "$DWN_VERSION" && exit 0
}

# print usage and exit if no arguments specified.
if [[ "$#" -eq 0 ]]; then
  print_usage_exit
fi

# ensure list directory exists.
if [[ ! -d "$DIR_LIST" ]]; then
  mkdir "$DIR_LIST"
fi

# parse commands and long options manually.
while [[ $# -gt 0 ]]; do
  case "$1" in
  version | --version)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    print_version_exit
    ;;
  usage | help | --help)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    print_usage_exit
    ;;
  continue)
    DWN_CMD=continue
    shift
    ;;
  ls | list)
    DWN_CMD=list
    shift
    ;;
  rm | remove)
    DWN_CMD=remove
    shift
    ;;
  *)
    break
    ;;
  esac
done

# parse command-line options with getopts.
while getopts "acfhio:rv" opt; do
  case $opt in
  v)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    print_version_exit
    ;;
  h)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    print_usage_exit
    ;;
  o)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    has_output_file=1
    dwn_output_file="$OPTARG"
    ;;
  r)
    [[ "$DWN_CMD" != "dwn" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    do_remove_after_first_try=1
    ;;
  a)
    [[ "$DWN_CMD" != "remove" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    ;;
  c)
    [[ "$DWN_CMD" != "list" && "$DWN_CMD" != "remove" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    [[ "$DWN_CMD" == "list" ]] && do_show_complete_list=1
    ;;
  i)
    [[ "$DWN_CMD" != "list" && "$DWN_CMD" != "remove" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    [[ "$DWN_CMD" == "list" ]] && do_show_incomplete_list=1
    ;;
  f)
    [[ "$DWN_CMD" != "remove" ]] && log_error_exit $ERROR_OPTION_INVALID_CMD
    ;;
  \?)
    print_usage_exit
    ;;
  esac
done

# remove parsed options and arguments.
shift $((OPTIND - 1))

function generate_id() {
  openssl rand -hex 4
}

# $1 id.
function get_list_item_output_file() {
  head -n 1 "$DIR_LIST/$1"
}

# $1 id.
function get_list_item_url() {
  head -n 2 "$DIR_LIST/$1" | tail -n 1
}

# $1 id.
function get_list_item_size() {
  head -n 3 "$DIR_LIST/$1" | tail -n 1
}

# $1 id.
# $2 absolute path of output file.
# $3 url.
# $4 content size in bytes.
# create list item file with following lines:
#  - output file path
#  - url
#  - content size in bytes
function create_list_item() {
  printf '%s\n%s\n%s' "$2" "$3" "$4" >"$DIR_LIST/$1" && log "[$1]: created"
}

# $@ space separated ids.
function remove_list_items() {
  for id in "$@"; do
    rm "$DIR_LIST/$id" && log "[$id]: removed"
  done
}

# return the number of items in the list (will return 0 if no items).
# display list of items in a table if any.
function show_list_items() {
  local count=$(ls "$DIR_LIST" | wc -l | tr -d ' ')
  if [[ "$count" -eq 0 ]]; then
    log "$count items" && exit 0
  fi

  local table='ID|%%|Progress|Output|URL\n`|`|`|`\n'
  for item in "$DIR_LIST"/*; do
    if file_exists "$item"; then
      local id="$(basename "$item")"
      local item_output_file=$(get_list_item_output_file "$id")
      local item_size=$(get_list_item_size "$id")
      local file_size=$(file_exists "$item_output_file" && cat "$item_output_file" | wc -c | tr -d ' ' || printf 0)
      local percent=$(printf %.f $(($file_size * 100 / $item_size)))
      bool $do_show_complete_list && [[ "$percent" -ne 100 ]] && continue
      bool $do_show_incomplete_list && [[ "$percent" -eq 100 ]] && continue
      table+="$id|$percent|[$file_size/$item_size]|$item_output_file|$(get_list_item_url "$id")\n"
    fi
  done

  log "$count items\n"
  printf "$table" | column -t -s '|'
}

# $1 id.
function download_list_item() {
  log "[$1]: download\n"
  wget -c -nv --show-progress -O "$(get_list_item_output_file "$1")" "$(get_list_item_url "$1")"
}

# $@ space separated ids.
function continue_list_items() {
  typeset -i count=0
  local items=
  _tmp_f_continue=$(mktemp)

  # get all valid items to continue.
  for id in "$@"; do
    if file_exists "$DIR_LIST/$id"; then
      count+=1
      items+="$(get_list_item_url "$id") $(get_list_item_output_file "$id")\n"
    else
      log_warn "[$id]: missing"
    fi
  done

  log "$count items"
  # exit if no items to continue.
  [[ "$count" -eq 0 ]] && exit 0
  printf "$items" >"$_tmp_f_continue"

  # continue downloading items.
  wget -c -nv --show-progress -i "$_tmp_f_continue"
}

function run_dwn() {
  if bool $has_output_file; then
    # check if the output file exists.
    [[ -f "$dwn_output_file" ]] && log_error_exit $ERROR_DWN_OUTPUT_FILE_EXISTS
    # check if the output file can be created.
    [[ ! -e "$dwn_output_file" && -w "$(dirname "$dwn_output_file")" ]] || log_error_exit $ERROR_DWN_OUTPUT_FILE_INVALID
    # get absolute path of output file.
    dwn_output_file=${dwn_output_file:P}
  else
    # use the basename of the url as the output file.
    dwn_output_file="$(basename "$dwn_url")"
    dwn_output_file=${dwn_output_file:P}
  fi

  id=$(generate_id)

  # create unique id.
  while file_exists "$DIR_LIST/$id"; do
    id=$(generate_id)
  done

  local content_length=$(wget --spider --server-response --tries=1 "$dwn_url" 2>&1 | sed -n 's/[[:space:]]*Content-Length:[[:space:]]*//p')

  [[ -z "$content_length" ]] && log_error_exit $ERROR_DWN_PING_FAILED
  create_list_item "$id" "$dwn_output_file" "$dwn_url" "$content_length"
  download_list_item "$id" && bool $do_remove_after_first_try && remove_list_items "$id"
}

function run_continue() {
  continue_list_items "$@"
}

function run_list() {
  show_list_items
}

function run_remove() {
  remove_list_items "$@"
}

# run command.
case "$DWN_CMD" in
dwn)
  dwn_url="$1"
  run_dwn
  ;;
continue)
  run_continue "$@"
  ;;
list)
  run_list
  ;;
remove)
  run_remove "$@"
  ;;
*)
  log_error_exit $ERROR_RUN_COMMAND_UNKNOWN
  break
  ;;
esac

# remove temp directory on exit.
trap 'rm -rf -- "$DIR_TEMP"' EXIT
