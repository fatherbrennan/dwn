PROG_NAME=dwn
PROG_VERSION=  # format: 0.0.0
PROG_CMD=dwn   # dwn | continue | list | remove
SYS_OS=macos   # macos | linux | windows
DEV_MODE=1     # always overwrite installed version.
DIR_TEMP="$(mktemp -d)"
FILE_ZSHRC="$HOME/.zshrc"
INSTALLER_LOG=
INSTALLER_STEP=start
read -d '' -r ENV_VARIABLES_TEXT <<-'EOF'
# dwn
export DWN_INSTALL="$HOME/.dwn"
export PATH="$DWN_INSTALL/bin:$PATH"
EOF

# error codes.
E_SYS_OS_UNKNOWN=001
E_SYS_OS_UNSUPPORTED=002
E_PERMISSIONS_BIN_DIR=010
E_ENV_VARS_APPEND=020
E_ENV_VARS_WRITE=021
E_ENV_VARS_REMOVE=022
E_ENV_VARS_SOURCE=023
E_CONFIG_DIR_REMOVE=030

# error code messages.
typeset -A ERROR=()
ERROR[$E_SYS_OS_UNKNOWN]="unknown operating system: $OSTYPE"
ERROR[$E_SYS_OS_UNSUPPORTED]="unsupported operating system: $OSTYPE"
ERROR[$E_PERMISSIONS_BIN_DIR]='error setting permissions of bin directory'
ERROR[$E_ENV_VARS_APPEND]="cannot append environment variables to $FILE_ZSHRC"
ERROR[$E_ENV_VARS_WRITE]="cannot write environment variables to $FILE_ZSHRC"
ERROR[$E_ENV_VARS_REMOVE]="error removing environment variables from $FILE_ZSHRC"
ERROR[$E_ENV_VARS_SOURCE]="error sourcing environment variables from $FILE_ZSHRC"
ERROR[$E_CONFIG_DIR_REMOVE]="error removing $PROG_NAME config directory"

log_error_exit() {
  printf '[%s] %s [ERROR:%s]:\t%b\n' \
    "$INSTALLER_LOG" "$INSTALLER_STEP" "$1" "$ERROR[$1]" &&
    exit 1
}

log() {
  printf '[%s] %s\t%b\n' "$INSTALLER_LOG" "$INSTALLER_STEP" "$1"
}

# return expected result of bool function.
# 0 = false
# 1 = true
# $1 `0` or `1`
bool() {
  [[ $1 -eq 1 ]] && return 0 || return 1
}

# return 0 when file exists.
# $1 file path.
file_exists() {
  [[ -e "$1" ]] && return 0 || return 1
}

# set the operating system.
# error if not supported.
set_os() {
  case "$OSTYPE" in
    'darwin'*) SYS_OS=macos ;;
    'linux'*) SYS_OS=linux ;;
    'cygwin' | 'msys' | 'win32')
      SYS_OS=windows
      log_error_exit $E_SYS_OS_UNSUPPORTED
      ;;
    *) log_error_exit $E_SYS_OS_UNKNOWN ;;
  esac
}

# remove temp directory on exit.
trap 'rm -rf -- "$DIR_TEMP"' EXIT
